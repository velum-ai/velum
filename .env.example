# Copy to .env and fill in. Dev: `npm run dev`. Production: see the
# "production" notes on NEXT_PUBLIC_SITE_URL, DATA_DIR and Dodo below, then
# `docker compose up -d --build` (or `npm ci && npm run db:migrate && npm run
# build && npm start`). Restart the process after any change here.

# ---------------------------------------------------------------- required ---

# Postgres. Supabase: DATABASE_URL is the "Transaction pooler" (port 6543,
# multiplexed - never hits the session pooler's 15-client cap) for the app;
# DIRECT_URL is the "Session pooler" (port 5432) for migrations. Both required.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# Chat and image generation, both through OpenRouter (any model, one key).
# Priced model ids live in src/lib/pricing.js; `npm run sync-models` refreshes
# their prices.
OPENROUTER_API_KEY=sk-or-v1-...

# Signs the short-lived URLs the browser uses to load stored images, and
# derives the key that encrypts chat content at rest. MUST be set in
# production (the dev fallback derives a weak key from DATABASE_URL).
# Generate: openssl rand -hex 32. Changing it after data exists makes old
# rows unreadable, back it up somewhere safe.
APP_SECRET=

# Canonical origin, no trailing slash. Used for OG tags, the sitemap, and the
# payment return URL.
# production: NEXT_PUBLIC_SITE_URL=https://velum.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- payments (Dodo Payments, merchant of record) ---
# Create a ONE-TIME product priced at $1.00 (= 100 credits). Payment routes
# return 503 until DODO_API_KEY and DODO_PRODUCT_ID are both set.
DODO_API_KEY=
DODO_PRODUCT_ID=
# Standard Webhooks secret. Point the webhook at
# https://<your-domain>/api/payments/webhook, subscribed to
# "payment.succeeded" and "payment.failed". Required in live mode.
DODO_WEBHOOK_SECRET=
# "test" (default) or "live". Test and live are separate in Dodo's dashboard,
# none of the three values above carry over between modes.
# production: DODO_MODE=live
# DODO_MODE=test
# Credits per unit of the product. Change only if the product isn't $1 = 100cr.
# DODO_CREDITS_PER_UNIT=100
# Dodo API timeout in ms (default 10000).
# DODO_TIMEOUT_MS=10000

# --- payments (BTCPay Server, self-hosted, Monero, optional) ---
# A second, non-custodial top-up path: no processor sees the account number
# or holds funds. Point at your own BTCPay instance (deployed separately, via
# BTCPay's own install script, not part of this repo's Docker Compose).
# Payment routes for this method return 503 until all four are set; the
# "monero" option on /account only appears once they are.
# BTCPAY_URL=https://pay.your-domain.com
# BTCPAY_STORE_ID=
# BTCPAY_API_KEY=
# Webhook secret from the BTCPay store's webhook settings. Point the webhook
# at https://<your-domain>/api/payments/btcpay/webhook, event "InvoiceSettled"
# (also add "InvoiceExpired" and "InvoiceInvalid" to mark failed top-ups).
# BTCPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- optional ---

# Where stored chat images live. Mount a volume here in Docker.
# production: DATA_DIR=/data
# DATA_DIR=.data

# Reasoning effort, forwarded to models that expose it: minimal | low | medium
# | high | off.
# REASONING_EFFORT=low

# Image generation model (must return an image) and its assumed cost in USD
# per image, before margin.
# IMAGE_MODEL=google/gemini-2.5-flash-image
# IMAGE_USD=0.04

# Point chat at a different OpenAI-compatible /chat/completions endpoint
# instead of OpenRouter.
# UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
# UPSTREAM_API_KEY=sk-...

# Markup over the model's token price. 1.4 = +40%. Covers OpenRouter's fee,
# payment/tax fees on top-ups, refunds on cancelled replies, hosting, margin.
# LLM_MARGIN=1.4

# Max reply length (tokens) held per reservation.
# MAX_OUTPUT_TOKENS=4000

# Trial credits for a new account. Default 0 (pay before first use).
# SIGNUP_CREDITS=0

# Web search: a "web_search" tool the model can call on its own when it
# decides a reply needs current information, via Brave Search's paid API.
# Billed per call, flat SEARCH_USD with the same margin as everything else.
# Leave BRAVE_API_KEY unset to disable it.
# BRAVE_API_KEY=
# SEARCH_USD=0.005

# Code execution: a "run_python" tool the model can call on its own during a
# reply, via E2B's sandboxes. Billed per run, flat CODE_EXEC_USD with the
# same margin as everything else. Leave E2B_API_KEY unset to disable it;
# models that don't support tool use fall back to a normal reply either way.
# E2B_API_KEY=
# CODE_EXEC_USD=0.01
