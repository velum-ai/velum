# --- required ---

# Postgres. Supabase: DATABASE_URL is the "Transaction pooler" (port 6543,
# multiplexed) for the app; DIRECT_URL is the "Session pooler" (port 5432) for
# migrations. Both are required.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# Provider for both chat and image generation. velum runs on OpenRouter (any
# model, one key). The MODELS list in src/lib/pricing.js holds the priced ids;
# `npm run sync-models` refreshes their prices.
OPENROUTER_API_KEY=sk-or-v1-...

# Signs the short-lived URLs the browser uses to load stored images, and
# derives the key that encrypts chat content at rest. Set a long random
# string in production; the fallback derives one from DATABASE_URL. Changing
# it after data exists makes old rows unreadable.
APP_SECRET=

# --- payments (Dodo Payments, merchant of record) ---
# Create a ONE-TIME product priced at $1.00 (= 100 credits). Its id goes here.
# Payment routes return 503 until DODO_API_KEY and DODO_PRODUCT_ID are both set.
DODO_API_KEY=
DODO_PRODUCT_ID=
# Standard Webhooks secret. Point the webhook at
# https://<your-domain>/api/payments/webhook and subscribe to
# "payment.succeeded" and "payment.failed". Required in live mode.
DODO_WEBHOOK_SECRET=
# "test" (default) or "live".
# DODO_MODE=test
# Credits per unit of the product. Change only if the product is not $1 = 100cr.
# DODO_CREDITS_PER_UNIT=100
# See .env.production.example for a live checklist.

# --- payments (BTCPay Server, self-hosted, Monero) ---
# Optional second payment path, non-custodial: no processor sees the account
# number or holds funds. Point at your own BTCPay instance. Payment routes for
# this method return 503 until all three are set.
# BTCPAY_URL=https://pay.your-domain.com
# BTCPAY_STORE_ID=
# BTCPAY_API_KEY=
# Webhook secret from the BTCPay store's webhook settings. Point the webhook
# at https://<your-domain>/api/payments/btcpay/webhook, event: "InvoiceSettled"
# (also add "InvoiceExpired" and "InvoiceInvalid" to mark failed top-ups).
# BTCPAY_WEBHOOK_SECRET=

# --- optional ---

# Where stored chat images live. Mount a volume here in Docker.
# DATA_DIR=/data

# Reasoning effort, forwarded to models that expose it: minimal | low | medium
# | high | off.
# REASONING_EFFORT=low

# Image generation model (must return an image) and its assumed cost in USD per
# image, before margin.
# IMAGE_MODEL=google/gemini-2.5-flash-image
# IMAGE_USD=0.04

# Point chat at a different OpenAI-compatible /chat/completions endpoint.
# UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
# UPSTREAM_API_KEY=sk-...

# Markup over the model's token price. 1.4 = +40%. Covers OpenRouter's fee,
# payment/tax fees on top-ups, refunds on cancelled replies, hosting, margin.
# LLM_MARGIN=1.4

# Max reply length (tokens) held per reservation.
# MAX_OUTPUT_TOKENS=4000

# Trial credits for a new account. Default 0 (pay before first use).
# SIGNUP_CREDITS=0

# Canonical URL for metadata / OG tags; footer GitHub link (hidden if unset).
# NEXT_PUBLIC_SITE_URL=https://velum.example.com
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/velum
