# velum, production. Copy to .env on the server, fill it in, then:
#   npm ci && npm run db:migrate && npm run build && npm start
#   (or: docker compose up -d --build)
# Restart the process after any change here.
#
# Carries over unchanged from a working dev .env:
#   DATABASE_URL, DIRECT_URL, OPENROUTER_API_KEY, APP_SECRET, REASONING_EFFORT
# Changes for production:
#   NEXT_PUBLIC_SITE_URL -> https://velum.run
#   DATA_DIR             -> /data   (Docker volume)
#   DODO_MODE            -> live
#   DODO_API_KEY / DODO_PRODUCT_ID / DODO_WEBHOOK_SECRET -> LIVE dashboard values
#     (test and live are separate; nothing carries over)

# ---------------------------------------------------------------- required ---

# Postgres. Supabase: app runtime on the "Transaction pooler" (port 6543,
# multiplexed - never hits the session pooler's 15-client cap); migrations on
# the "Session pooler" (port 5432) via DIRECT_URL. Both required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Chat and image generation, all through OpenRouter. Priced model ids live in
# src/lib/pricing.js.
OPENROUTER_API_KEY=sk-or-v1-...

# Signs the short-lived attachment URLs, and derives the key that encrypts
# chat content at rest. MUST be set (the dev fallback derives a weak key from
# DATABASE_URL). Generate: openssl rand -hex 32. Changing it after data
# exists makes old rows unreadable, back it up somewhere safe.
APP_SECRET=

# Canonical origin. Absolute, https, no trailing slash. Used for OG tags, the
# sitemap, and the payment return URL.
NEXT_PUBLIC_SITE_URL=https://velum.run

# --- payments: Dodo Payments, LIVE dashboard values -------------------------
# In the LIVE dashboard: create a one-time product priced $1.00 (= 100 credits)
# and a webhook at https://velum.run/api/payments/webhook subscribed to
# "payment.succeeded" and "payment.failed". All three below are required.
DODO_MODE=live
DODO_API_KEY=
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=

# --- payments: BTCPay Server, optional, self-hosted, Monero -----------------
# A second, non-custodial top-up path. Requires your own BTCPay instance
# (separate from this app's server). Webhook at
# https://velum.run/api/payments/btcpay/webhook, event "InvoiceSettled" (add
# "InvoiceExpired" and "InvoiceInvalid" too). Leave unset to run card-only.
# BTCPAY_URL=
# BTCPAY_STORE_ID=
# BTCPAY_API_KEY=
# BTCPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- optional ---

# Chat image store. In Docker, mount a volume at this path.
DATA_DIR=/data

# Reasoning effort, forwarded to models that expose it: minimal | low | medium
# | high | off.
REASONING_EFFORT=low

# Image generation model (must return an image) and its assumed cost in USD
# per image, before margin.
# IMAGE_MODEL=google/gemini-2.5-flash-image
# IMAGE_USD=0.04

# Only if the Dodo product is NOT priced $1.00 = 100 credits.
# DODO_CREDITS_PER_UNIT=100
# Dodo API timeout in ms (default 10000).
# DODO_TIMEOUT_MS=10000

# Markup over the model's token price. 1.4 = +40%. Covers OpenRouter's fee,
# payment/tax fees on top-ups, refunds on cancelled replies, hosting, margin.
# LLM_MARGIN=1.4

# Max reply length (tokens) held per reservation.
# MAX_OUTPUT_TOKENS=4000

# Trial credits for a new account. Default 0 (pay before first use).
# SIGNUP_CREDITS=0

# Footer GitHub link (hidden when unset).
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/velum

# X (Twitter) ad conversion reporting, server-to-server only, no script or
# cookie in the browser. All three required; leave unset to report nothing.
# X_PIXEL_ID and X_API_KEY come from ads.x.com's Conversions API setup;
# X_EVENT_ID is a specific event's id from Events manager (Custom > Define
# with code), format "tw-<pixel>-<suffix>", copy it exactly, don't guess it.
# X_PIXEL_ID=
# X_API_KEY=
# X_EVENT_ID=
