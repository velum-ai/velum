# Example reverse-proxy config for self-hosting velum behind Caddy. Adjust
# the domain and reverse_proxy port to match your own setup (see
# docker-compose.yml, the app listens on 127.0.0.1:8293 by default).
#
# Security headers live here, not in next.config.mjs: setting them in both
# places sends duplicate/conflicting header lines for the same name, and
# browsers resolve conflicts unpredictably (X-Frame-Options especially, a
# conflicting pair is treated as the more restrictive value).

your-domain.example {
	encode gzip zstd

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		# microphone=(self): the composer's dictation feature needs it.
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), browsing-topics=()"
	}

	# Stored attachments (images, generated PDFs/docs) need to render in the
	# chat UI's own <iframe> preview panel. Everything else stays DENY; this
	# only relaxes framing for raw file bytes, on the same origin, nothing
	# here executes as HTML/script.
	@attachments path /api/attachments/*
	header @attachments {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'"
	}

	reverse_proxy localhost:8293
}
